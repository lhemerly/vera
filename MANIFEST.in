include LICENSE README.md pyproject.toml Cargo.toml Cargo.lock
recursive-include docs *.md
recursive-include examples *.vera *.json
recursive-include tests *.py
recursive-include tests/rust_frontend_fixtures *.vera
recursive-include tools *.py *.c
include rust/vera-rt/Cargo.toml rust/vera-rt/Cargo.lock
recursive-include rust/vera-rt/src *.rs
recursive-include rust/vera-compiler *.toml *.rs *.vera *.json
