# Decimal separators, minimum integers, full bytes32 width and generic closing.
module ExactSyntax;
table T capacity 2 {
  key id : id64<T>;
  col amount : dec128;
  col code : bytes32 [unique];
  col symbol : sym32;
}
transition create() reads [] writes [T[*].amount,T[*].code,T[*].symbol]
body {
  let %smallest : i64 = -9223372036854775808;
  let %tiny : dec128 = .000000000000000001;
  let %trailing : dec128 = -0.0000;
  let %large : dec128 = 1_000_000.000_000_000_000_000_001;
  let %negative : dec128 = -12345678901.123456789012345678;
  let %new : id64<T>=table_alloc(T,{
    amount : %tiny,
    code : 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff,
    symbol : "quote\" slash\\ newline\n tab\t zero\0 中文"
  });
  commit;
}
